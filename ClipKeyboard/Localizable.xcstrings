    "사용자 수" : {
      "comment" : "Chart axis: install count",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Users"
          }
        },
        "ru" : {
          "stringUnit" : {
