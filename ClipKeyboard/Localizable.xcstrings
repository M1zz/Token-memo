    "ClipKeyboard needs Accessibility permission to register global shortcuts. Grant access in System Settings → Privacy & Security → Accessibility." : {
      "comment" : "Auto-registered",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard needs Accessibility permission to register global shortcuts. Grant access in System Settings → Privacy & Security → Accessibility."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard needs Accessibility permission to register global shortcuts. Grant access in System Settings → Privacy & Security → Accessibility."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipKeyboard нужен доступ Accessibility для регистрации глобальных сочетаний клавиш. Предоставьте доступ в Системных настройках → Конфиденциальность и безопасность → Универсальный доступ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴键盘需要辅助功能权限才能注册全局快捷键。请在“系统设置 → 隐私与安全性 → 辅助功能”中授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
