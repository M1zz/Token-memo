    "단축어 추가" : {
      "comment" : "Add a snippet\nAdd memo card\nAdd memo menu label",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add snippet"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
