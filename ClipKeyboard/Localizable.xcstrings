      "comment" : "Changelog 5.0.4 image key overflow",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixed: keys next to an image snippet would not respond. A wide photo was spilling out of its cell and covering the key beside it"
