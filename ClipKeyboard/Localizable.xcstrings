    },
    "내용에 { }로 감싼 자리를 넣으면 여기 모여요. 이름이 같으면 여러 단축어가 값을 함께 씁니다." : {
      "comment" : "No placeholders description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrap part of your content in { } and it shows up here. Snippets that use the same name share its values."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оберните часть содержимого в { }, и оно появится здесь. Фразы с одинаковым именем используют общие значения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在内容里用 { } 括起来的位置会集中到这里。名字相同的话，多个短语会共用它的值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在內容裡用 { } 括起來的位置會集中到這裡。名字相同的話，多個短語會共用它的值。"
          }
        }
      }
    },
